export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    
    // This rewrites the destination to Discord's official API
    const targetUrl = "https://discord.com" + url.pathname + url.search;

    // Clone the request headers
    const newHeaders = new Headers(request.headers);
    
    // CRITICAL step: This hides Roblox's identity so Discord allows the request
    newHeaders.set("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)");

    const modifiedRequest = new Request(targetUrl, {
      method: request.method,
      headers: newHeaders,
      body: request.body
    });

    return await fetch(modifiedRequest);
  },
};
